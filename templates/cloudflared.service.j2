# {{ ansible_managed }}, source: templates/cloudflared.service.j2 in the ansible repo
[Unit]
Description=Cloudflare Tunnel client
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=15
Type=notify
# The token stays in /etc/cloudflared/token (root only), not on the command line.
# --metrics: /ready on port {{ cloudflared_metrics_port }} for Uptime Kuma (LAN only, no secrets)
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --metrics 0.0.0.0:{{ cloudflared_metrics_port }} run --token-file /etc/cloudflared/token
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
