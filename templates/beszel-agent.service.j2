# {{ ansible_managed }}, source: templates/beszel-agent.service.j2 in the ansible repo
# Same unit as Beszel's own install script, see docs/beszel.md
[Unit]
Description=Beszel Agent
Wants=network-online.target
After=network-online.target

[Service]
# The hub connects here; only its public key is accepted
Environment="LISTEN={{ beszel_agent_port }}"
Environment="KEY={{ beszel_hub_key }}"
{% for name, value in (beszel_agent_env | default({})).items() %}
Environment="{{ name }}={{ value }}"
{% endfor %}
ExecStart={{ beszel_agent_dir }}/beszel-agent
User=beszel
Restart=on-failure
RestartSec=5
StateDirectory=beszel-agent
{% if beszel_agent_smart | default(false) %}

# SMART: smartctl needs raw access to the disks, NVMe also CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_RAWIO CAP_SYS_ADMIN
{% endif %}
{% if beszel_agent_sandbox | default(true) %}

# Sandboxing. A container that cannot do it (status 226/NAMESPACE) gets
# beszel_agent_sandbox: false in inventory.yaml
KeyringMode=private
LockPersonality=yes
ProtectClock=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
RemoveIPC=yes
RestrictSUIDSGID=true
{% endif %}

[Install]
WantedBy=multi-user.target
