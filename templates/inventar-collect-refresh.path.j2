# Managed by Ansible (templates/inventar-collect-refresh.path.j2), change it there.
# "Jetzt aktualisieren" on the web page only writes this file; systemd then starts
# the normal collector run, which deletes it first. The web service itself never
# queries a source and needs no rights to start units. See docs/inventar.md.
[Unit]
Description=inventar: collector run requested from the web page

[Path]
PathExists={{ inventar_data }}/refresh.request
Unit=inventar-collect.service

[Install]
WantedBy=multi-user.target
