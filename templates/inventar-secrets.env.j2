# Created by Ansible (inventar_setup.yaml) once, never overwritten: fill in here.
# How to create the read-only credentials: docs/zugaenge.md in the inventar repo.
# *_VERIFY_TLS: true, false (self-signed certificate) or path to a CA file

# UniFi Network on the Cloud Gateway
UNIFI_URL=https://192.168.1.1
UNIFI_SITE=default
UNIFI_VERIFY_TLS=false
# official Integration API
UNIFI_API_KEY=
# classic API with a local View-Only user (reservations and offline devices)
UNIFI_USER=
UNIFI_PASSWORD=

# Pi-hole 6 (app password)
PIHOLE_URL=https://192.168.1.99
PIHOLE_VERIFY_TLS=false
PIHOLE_PASSWORD=
# Optional: second Pi-hole, only read to check that both are in sync (app password)
PIHOLE2_URL=https://192.168.1.59
PIHOLE2_VERIFY_TLS=false
PIHOLE2_PASSWORD=

# Nginx Proxy Manager (user that may only view proxy hosts)
NPM_URL=http://debian-npm.lan:81
NPM_USER=
NPM_PASSWORD=

# Proxmox cluster (API token with role PVEAuditor on /)
PROXMOX_URL=https://proxmox-n01.lan:8006
PROXMOX_VERIFY_TLS=false
PROXMOX_TOKEN_ID=inventar@pve!sammler
PROXMOX_TOKEN_SECRET=

# Optional: Cloudflare Tunnel routes (API token with Cloudflare Tunnel: Read)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Uptime Kuma monitors, read from /metrics (API key from Settings → API Keys)
UPTIME_KUMA_URL=http://debian-uptimekuma.lan:3001
UPTIME_KUMA_API_KEY=

# Ping scan
SCAN_NETWORK=192.168.1.0/24

# Optional: Uptime Kuma push monitor "Inventar Sammler", heartbeat after every run
# (down as soon as one source fails); any ?status=... at the end is ignored
UPTIME_KUMA_PUSH_URL=
